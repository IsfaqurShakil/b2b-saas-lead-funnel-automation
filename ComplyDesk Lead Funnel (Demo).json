      "name": "Webhook",
      "webhookId": "75c8b540-d9b9-468f-9dbe-803dd81977ba"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $('Webhook').first().json.body;\n\nconst freeDomains = ['gmail.com', 'yahoo.com', 'outlook.com', 'hotmail.com', 'icloud.com', 'live.com', 'aol.com', 'proton.me', 'protonmail.com'];\n\nconst email = (b.email || '').trim().toLowerCase();\nconst domain = email.split('@')[1] || '';\n\nconst sizePoints = { '200+': 25, '51-200': 20, '11-50': 15, '1-10': 5 };\nconst rolePoints = { ehs_compliance: 25, ops_founder: 15, other: 5 };\nconst needPoints = { setup_or_multisite: 20, exploring: 5 };\nconst timelinePoints = { within_1_month: 20, '1_3_months': 10, researching: 0 };\n\nconst score =\n  (sizePoints[b.company_size] || 0) +\n  (rolePoints[b.role] || 0) +\n  (needPoints[b.need] || 0) +\n  (timelinePoints[b.timeline] || 0) +\n  (freeDomains.includes(domain) ? 0 : 10);\n\nlet label = 'cold';\nif (score >= 70) label = 'hot';\nelse if (score >= 40) label = 'warm';\n\nreturn {\n  json: {\n    submitted_at: b.submitted_at,\n    name: b.name,\n    email: email,\n    company: b.company,\n    company_size: b.company_size,\n    role: b.role,\n    country: b.country,\n    need: b.need,\n    timeline: b.timeline,\n    utm_source: b.utm_source,\n    utm_medium: b.utm_medium,\n    utm_campaign: b.utm_campaign,\n    page_url: b.page_url,\n    score: score,\n    label: label,\n    status: 'new',\n    approval: label === 'hot' ? 'pending' : 'not_needed',\n    data_label: b.data_label\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
